{
  "realm": "rag-workspaces",
  "displayName": "rag-workspaces",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "external",
  "accessTokenLifespan": 900,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Manages everything in rag-workspaces: workspaces, members, API keys, usage."
      }
    ]
  },
  "clients": [
    {
      "clientId": "admin-ui",
      "name": "rag-workspaces admin UI",
      "description": "The browser app. Public client: authorization code with PKCE, no secret.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${RW_ADMIN_UI_URL}/*", "http://localhost:5173/*"],
      "webOrigins": ["${RW_ADMIN_UI_URL}", "http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${RW_ADMIN_UI_URL}/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "api",
      "name": "rag-workspaces API",
      "description": "Resource server. Exists so access tokens can name it as their audience; it signs nobody in.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "api-directory",
      "name": "rag-workspaces API: people list",
      "description": "Confidential client the API uses to read the realm's people for GET /v1/users. Its service account can only view users.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${RW_API_DIRECTORY_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "roles", "kc-admin-api"],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "${RW_ADMIN_USERNAME}",
      "email": "${RW_ADMIN_EMAIL}",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "rag-workspaces",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${RW_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-rag-workspaces", "admin"]
    },
    {
      "username": "service-account-api-directory",
      "enabled": true,
      "serviceAccountClientId": "api-directory",
      "clientRoles": {
        "realm-management": ["view-users"]
      }
    }
  ]
}
