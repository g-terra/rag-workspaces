# Serves the admin UI and forwards /api/* to the API, so the browser only ever
# talks to one origin (no CORS) and the API stays reachable for scripts on :3000.
# A template: the nginx image fills in ${MAX_UPLOAD_BYTES} from the environment when it starts, and
# leaves nginx's own variables ($host, $uri) alone because they aren't set in the environment.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  # Uploads go through here too: the same limit as the API (compose passes MAX_UPLOAD_BYTES to both).
  client_max_body_size ${MAX_UPLOAD_BYTES};

  location /api/ {
    proxy_pass http://api:3000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Streamed answers and ingestion status are server-sent events: don't buffer them.
    proxy_buffering off;
    # Pass uploads straight on instead of first writing them to a temp file here (videos can be 2 GB).
    proxy_request_buffering off;
    proxy_read_timeout 1h;
  }

  # Hashed assets never change; cache them for a year.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Single-page app: unknown paths get index.html and React Router takes over (M4).
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
