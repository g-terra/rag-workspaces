# Copy with `pnpm env:init`: it writes .env with fresh random secrets for every
# value marked <generated>. Edit the rest by hand if you need to.

# --- Postgres (app data, plus the langflow and keycloak databases) ---
POSTGRES_USER=rag
POSTGRES_DB=rag
POSTGRES_PASSWORD=<generated>

# --- Langflow ---
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=<generated>
# Must be a Fernet key (32 url-safe base64 bytes), not hex. env:init makes one.
LANGFLOW_SECRET_KEY=<generated>
# Optional fallback: a key made by hand in the Langflow UI, used only if the API cannot
# sign in as the superuser above to make its own.
LANGFLOW_API_KEY=
# Do NOT add OPENAI_API_KEY or other provider keys for Langflow here (see poc/RESULTS.md F3).

# --- Keycloak ---
# Keycloak's own admin console (http://auth.rag.localhost/admin), where you create people.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<generated>
# The first rag-workspaces admin, created in the rag-workspaces realm on first start.
RW_ADMIN_USERNAME=admin
RW_ADMIN_EMAIL=admin@example.com
RW_ADMIN_PASSWORD=<generated>
# Secret of the api-directory client, the read-only service account the API lists people with.
KEYCLOAK_DIRECTORY_SECRET=<generated>
# URLs as the browser sees them, through the proxy's local names. Tokens carry KEYCLOAK_PUBLIC_URL
# as their issuer. With PROXY_PORT other than 80, add it to each, for example http://rag.localhost:8088.
# To skip the names, use http://localhost:8081, :8080 and :3000 instead.
KEYCLOAK_PUBLIC_URL=http://auth.rag.localhost
ADMIN_UI_URL=http://rag.localhost
PUBLIC_API_URL=http://api.rag.localhost

# --- Models ---
# Embedding provider and model pinned into each new workspace (lmstudio, openai or gemini).
# For LM Studio, use the exact model id from `curl localhost:1234/v1/models`.
DEFAULT_EMBEDDING_PROVIDER=lmstudio
DEFAULT_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# LM Studio on this machine, as containers reach it (the default provider, needs no key).
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
# Chat model for workspaces that do not set their own (lmstudio, openai, anthropic, gemini).
DEFAULT_CHAT_PROVIDER=lmstudio
DEFAULT_CHAT_MODEL=qwen2.5-7b-instruct
# Cosine similarity a passage needs to count as relevant (0 to 1). Each workspace can override it.
DEFAULT_MIN_SCORE=0.3
# Optional hosted providers. The API sends these to Langflow per run; Langflow never holds them.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Video and audio (optional) ---
# Uncomment both to transcribe MP4, MP3 and WAV uploads with Whisper (an extra ~1 GB image, plus the model).
# COMPOSE_PROFILES=video
# WHISPER_URL=http://whisper:9000
# Whisper model: tiny, base, small, medium or large-v3 (bigger is slower and more accurate).
WHISPER_MODEL=base

# --- Ports on 127.0.0.1 ---
# The proxy behind rag.localhost and the other names.
PROXY_PORT=80
API_PORT=3000
WEB_PORT=8080
LANGFLOW_PORT=7860
KEYCLOAK_PORT=8081

# Requests per minute for each person or API key: all of /v1, and the ones that run a model
# (searches, answers, chat messages). Over the limit the API answers 429 with Retry-After. 0 turns one off.
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_MODEL_PER_MINUTE=30

# Largest file one upload may hold, in bytes (2 GB, so lecture videos fit). The API and the admin UI's
# nginx both read it; run `docker compose up -d` after changing it.
MAX_UPLOAD_BYTES=2147483648

# Question text in the usage log is cleared after this many days (counts and latency stay).
USAGE_QUESTION_RETENTION_DAYS=90

LOG_LEVEL=info
