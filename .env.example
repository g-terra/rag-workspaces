# Copy with `pnpm env:init`: it writes .env with fresh random secrets for every
# value marked <generated>. Edit the rest by hand if you need to.

# --- Postgres (app data, plus the langflow and keycloak databases) ---
POSTGRES_USER=rag
POSTGRES_DB=rag
POSTGRES_PASSWORD=<generated>

# --- Langflow ---
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=<generated>
# Must be a Fernet key (32 url-safe base64 bytes), not hex. env:init makes one.
LANGFLOW_SECRET_KEY=<generated>
# Do NOT add OPENAI_API_KEY or other provider keys for Langflow here (see poc/RESULTS.md F3).

# --- Keycloak ---
# Keycloak's own admin console (http://localhost:8081/admin), where you create people.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<generated>
# The first rag-workspaces admin, created in the rag-workspaces realm on first start.
RW_ADMIN_USERNAME=admin
RW_ADMIN_EMAIL=admin@example.com
RW_ADMIN_PASSWORD=<generated>
# URLs as the browser sees them. Tokens carry KEYCLOAK_PUBLIC_URL as their issuer.
KEYCLOAK_PUBLIC_URL=http://localhost:8081
ADMIN_UI_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:3000

# --- Ports on 127.0.0.1 ---
API_PORT=3000
LANGFLOW_PORT=7860
KEYCLOAK_PORT=8081

LOG_LEVEL=info
