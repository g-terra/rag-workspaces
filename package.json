{
  "name": "rag-workspaces",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "env:init": "node scripts/env-init.ts",
    "setup": "node scripts/setup.ts",
    "test:scripts": "node --test \"scripts/**/*.test.ts\"",
    "test:langflow": "cd langflow && uv run --managed-python --no-project --python 3.14 --with-requirements requirements-test.txt pytest",
    "smoke": "node scripts/smoke/run.ts",
    "e2e": "node scripts/smoke/e2e.ts"
  },
  "devDependencies": {
    "@clack/prompts": "1.9.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "5.9.3"
  }
}
