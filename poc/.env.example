# Copy to .env (scripts/up.sh does this and fills the secret for you).
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=change-me-please
# Must be 32 url-safe base64 bytes (a Fernet key), NOT hex. Generate with:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
LANGFLOW_SECRET_KEY=
# Do NOT set OPENAI_API_KEY here for LM Studio: Langflow 1.13 refuses to send a key
# that comes from the server environment to a non-OpenAI host. The flows carry a
# dummy key ("lm-studio") instead, which LM Studio ignores.
