{
  "name": "@rag/langflow-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client for the parts of Langflow's HTTP API the API uses: login, API keys, flows, run and stream.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@rag/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
